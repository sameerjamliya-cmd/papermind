# ===== Server (server/.env) =====
PORT=3001

# Postgres (Railway in production)
DATABASE_URL=postgresql://user:password@host:5432/papermind

# Better Auth
BETTER_AUTH_SECRET=            # min 32 chars, e.g. `openssl rand -base64 32`
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLIENT_URL=http://localhost:3000   # comma-separate extra origins, e.g. https://domain.com,https://www.domain.com

# AI / Integrations
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
MEM0_API_KEY=

# Inngest Cloud (production only — leave unset for local dev server)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Memory sync tuning
MEMORY_SYNC_MESSAGE_THRESHOLD=10
MEMORY_SUMMARY_MESSAGE_WINDOW=20

# Optional: local Kokoro TTS service
KOKORO_TTS_URL=http://127.0.0.1:8001

# Logging: debug | info | warn | error (default info)
LOG_LEVEL=info

# ===== Client (client/.env.local) =====
NEXT_PUBLIC_API_URL=http://localhost:3001
